# System unit installed by the .deb/.rpm packages (example/restor.service is the copy for
# manual installs into /usr/local/bin).
[Unit]
Description=Restic Backup Orchestrator

[Service]
# No [Install] section: the timer starts this unit. Enabling the service itself would
# run a backup, which stops services, at every boot.
Type=oneshot
ExecStart=/usr/bin/restor run --config /etc/restor/config.yaml
# On stop, restor restarts the services it stopped, runs the jobs' post hooks and exits
# within its shutdown timeout (logged as shutdown_timeout: the largest start_timeout + 4
# minutes, + 1 minute for a post hook); give it longer than that before systemd kills it.
# 900 s covers a start_timeout up to 10 minutes.
TimeoutStopSec=900
# Back up at a lower CPU and I/O priority than the services (best-effort, not idle: an
# idle backup could starve under load while the services are stopped).
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal
