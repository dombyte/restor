[Unit]
Description=Restic Backup Orchestrator
# A run the timer catches up at boot (Persistent=true) must wait for the network (a
# remote repository) and for the container engines: before they have started the
# containers, restor finds nothing running, stops nothing and backs up live data. After=
# on an engine that is not installed is ignored.
Wants=network-online.target
After=network-online.target docker.service podman-restart.service

[Service]
# No [Install] section: the timer starts this unit. Enabling the service itself would
# run a backup, which stops services, at every boot.
Type=oneshot
ExecStart=/usr/local/bin/restor run --config /etc/restor/config.yaml
# On stop, restor restarts the services it stopped, runs the jobs' post hooks and exits
# within its shutdown timeout (logged as shutdown_timeout: the largest start_timeout + 4
# minutes, + 1 minute for a post hook); give it longer than that before systemd kills it.
# 900 s covers a start_timeout up to 10 minutes.
TimeoutStopSec=900
# restor signals the commands it runs itself on stop (SIGTERM to each process group,
# SIGKILL 10 s later), so systemd only signals restor. With the default (control-group)
# it would also wait for, and finally kill, what must outlive the run: with podman-compose
# the conmon of every container restor restarted stays in this unit's cgroup.
KillMode=process
# Back up with less CPU and I/O than the services get. Weights instead of Nice= and
# IOSchedulingClass=, which every child process inherits: the containers podman-compose
# restarts would keep running at the lower priority. Weights are not inherited (the
# containers get cgroups of their own) and, unlike idle classes, never starve a backup
# while the services are stopped.
CPUWeight=20
IOWeight=20
StandardOutput=journal
StandardError=journal
