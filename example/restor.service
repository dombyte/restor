[Unit]
Description=Restic Backup Orchestrator

[Service]
Type=oneshot
ExecStart=/usr/local/bin/restor run --config /etc/restor/config.yaml
# On stop, restor restarts the services it stopped and exits within its shutdown timeout
# (logged as shutdown_timeout: the largest start_timeout + 4 minutes); give it longer than
# that before systemd kills it. 900 s covers a start_timeout up to 11 minutes.
TimeoutStopSec=900
# Back up at a lower CPU and I/O priority than the services (best-effort, not idle: an
# idle backup could starve under load while the services are stopped).
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
