# restor env file: variables for restic only (repository.env_file).
# ===================================================================
#
# Format: one KEY=value per line, as systemd's EnvironmentFile=. "export " is allowed,
# # starts a comment, and values in "double" or 'single' quotes are taken as is.
# Values are taken LITERALLY: nothing is expanded, a "$" in a password stays a "$".
# Keep the file private: chmod 600 (restor warns when others can read it).

# ------------------------------------------------------------------------------
# Repository password: choose ONE.
# ------------------------------------------------------------------------------
# A file that holds only the password (recommended; chmod 600):
RESTIC_PASSWORD_FILE=/etc/restor/restic-password
# The password itself:
# RESTIC_PASSWORD=your-very-secret-password
# A command that prints the password:
# RESTIC_PASSWORD_COMMAND=/usr/local/bin/get-restic-password

# The repository can be set here instead of repository.url:
# RESTIC_REPOSITORY=s3:https://s3.amazonaws.com/your-backups
# RESTIC_REPOSITORY_FILE=/etc/restor/restic-repository

# ------------------------------------------------------------------------------
# Backend credentials
# ------------------------------------------------------------------------------
# S3 and S3-compatible storage (MinIO, Wasabi, ...):
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_DEFAULT_REGION=eu-central-1

# Backblaze B2:
# B2_ACCOUNT_ID=your-account-id
# B2_ACCOUNT_KEY=your-account-key

# Azure Blob Storage:
# AZURE_ACCOUNT_NAME=your-account
# AZURE_ACCOUNT_KEY=your-key

# ------------------------------------------------------------------------------
# restic settings that have no key in config.yaml
# ------------------------------------------------------------------------------
# RESTIC_CACHE_DIR=/var/cache/restic
# RESTIC_COMPRESSION=auto
# RESTIC_PACK_SIZE=64
# RESTIC_READ_CONCURRENCY=4
# RESTIC_HOST=myhost
