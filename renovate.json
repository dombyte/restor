{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "gomod",
    "github-actions",
    "custom.regex"
  ],
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":enableVulnerabilityAlertsWithLabel('security')",
    ":rebaseStalePrs",
    "group:recommended",
    ":semanticCommits"
  ],
  "labels": ["renovate"],
  "ignoreUnstable": true,
  "timezone": "Europe/Berlin",
  "minimumReleaseAge": "3 days",
  "automergeType": "pr",
  "automergeStrategy": "merge-commit",
  "platformAutomerge": false,
  "automergeSchedule": ["* 0-5 * * *"],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "groupName": "Go dependencies",
      "postUpdateOptions": ["gomodTidy"]
    },
    {
      "description": "Non-major updates merge by themselves once the required checks pass, only within automergeSchedule",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "description": "A Go major version is a new module path (mockery/v3 -> mockery/v4) and needs code changes; update by hand",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "golangci-lint majors change the .golangci.yml format; upgrade by hand",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["golangci/golangci-lint"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "goreleaser majors change the .goreleaser.yaml format; upgrade by hand",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["goreleaser/goreleaser"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "A restic major may change its CLI or JSON output; raise the tested version by hand",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["restic/restic"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Bumping the tested restic release only changes tests and docs",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["restic/restic"],
      "semanticCommitType": "test",
      "semanticCommitScope": "restic"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ],
  "customManagers": [
    {
      "description": "Versions marked with a `# renovate: datasource=… depName=…` (CI workflows) or `// renovate: …` (Go) comment: the newest restic release restor is tested with",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/", "/^internal/restic/version\\.go$/"],
      "matchStrings": ["(?<currentValue>\\d+\\.\\d+\\.\\d+)\"?\\s*(?:#|//) renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)"],
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "semver"
    },
    {
      "description": "golangci-lint version pinned in the CI action (`version: vX.Y`); the github-actions manager only tracks the action itself",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["golangci/golangci-lint-action@\\S+\\s+with:\\s+version:\\s*(?<currentValue>v\\d+\\.\\d+(?:\\.\\d+)?)"],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "description": "goreleaser version pinned in the release action (`version: vX.Y.Z`); the github-actions manager only tracks the action itself",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["goreleaser/goreleaser-action@\\S+\\s+with:\\s+distribution:\\s*goreleaser\\s+version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "goreleaser/goreleaser",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "separateMinorPatch": true,
  "stopUpdatingLabel": "renovate/stop_updating"
}
